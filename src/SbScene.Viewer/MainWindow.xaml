<Window x:Class="SbScene.Viewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SbScene.Viewer"
        mc:Ignorable="d"
        Title="SbScene Viewer"
        MinHeight="640"
        MinWidth="980"
        Height="820"
        Width="1280"
        Background="#F5F7FA"
        AllowDrop="True"
        Drop="Window_Drop">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="MinHeight" Value="30" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="10,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#1F2933" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#1F2933" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#D7DDE5" BorderThickness="0,0,0,1" Padding="0">
            <DockPanel LastChildFill="True">
                <Menu DockPanel.Dock="Top" Background="#FFFFFF" Padding="8,2">
                    <MenuItem Header="文件">
                        <MenuItem Header="打开 sbscene..." Click="OpenScene_Click" />
                        <MenuItem Header="绑定 SVO..." Click="OpenSvo_Click" />
                        <Separator />
                        <MenuItem Header="重新载入" Click="Reload_Click" />
                        <Separator />
                        <MenuItem Header="导出 GIF..." Click="ExportGif_Click" />
                    </MenuItem>
                    <MenuItem Header="查看">
                        <MenuItem Header="适合窗口" Click="Fit_Click" />
                        <Separator />
                        <MenuItem x:Name="ShowHiddenCheckBox"
                                  Header="隐藏节点也绘制"
                                  IsCheckable="True"
                                  Checked="RenderOption_Changed"
                                  Unchecked="RenderOption_Changed" />
                        <MenuItem x:Name="ShowMarkersCheckBox"
                                  Header="调试节点标记"
                                  IsCheckable="True"
                                  IsChecked="False"
                                  Checked="RenderOption_Changed"
                                  Unchecked="RenderOption_Changed" />
                    </MenuItem>
                    <MenuItem Header="Unity 导出">
                        <MenuItem Header="生成 profiletemplate JSON..." Click="ExportUnityNavicharaProfileTemplate_Click" />
                        <MenuItem Header="根据 profiletemplate 生成 navichara-export.json..." Click="ExportUnityNavichara_Click" />
                    </MenuItem>
                </Menu>
                <DockPanel Margin="12,8,12,10" LastChildFill="False">
                    <StackPanel Margin="15,0,5,0" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="缩放" VerticalAlignment="Center" Foreground="#5E6B7A" />
                        <Slider x:Name="ZoomSlider"
                                Width="160"
                                Minimum="0.1"
                                Maximum="4"
                                TickFrequency="0.1"
                                Value="1"
                                ValueChanged="ZoomSlider_ValueChanged" />
                        <TextBlock x:Name="ZoomTextBlock"
                                   Width="52"
                                   TextAlignment="Right"
                                   VerticalAlignment="Center"
                                   Foreground="#5E6B7A" />
                    </StackPanel>
                </DockPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" MinWidth="280" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" MinWidth="360" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="380" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#F7F9FC" BorderBrush="#D7DDE5" BorderThickness="0,0,1,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="12" Background="#FFFFFF" BorderBrush="#D7DDE5" BorderThickness="0,0,0,1">
                        <StackPanel>
                            <TextBlock x:Name="SceneTitleTextBlock" FontSize="15" FontWeight="SemiBold" Text="未加载 scene" />
                            <TextBlock x:Name="SceneSummaryTextBlock"
                                       Margin="0,6,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="#5E6B7A" />
                            <TextBlock x:Name="SvoSummaryTextBlock"
                                       Margin="0,4,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="#28775B" />
                        </StackPanel>
                    </Border>
                    <TreeView x:Name="NodeTree"
                              Background="#F7F9FC"
                              BorderThickness="0"
                              Foreground="#11151A"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              SelectedItemChanged="NodeTree_SelectedItemChanged">
                        <TreeView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="显示此节点和子节点" Click="ShowSubtree_Click" />
                                <MenuItem Header="隐藏此节点和子节点" Click="HideSubtree_Click" />
                                <Separator />
                                <MenuItem Header="恢复源文件显示状态" Click="ResetSubtreeVisibility_Click" />
                            </ContextMenu>
                        </TreeView.ContextMenu>
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="{x:Type TreeViewItem}">
                                <Setter Property="IsExpanded" Value="True" />
                                <EventSetter Event="PreviewMouseRightButtonDown" Handler="NodeTreeItem_PreviewMouseRightButtonDown" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <Grid MinWidth="260" Margin="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Margin="5,0" Text="{Binding Index}" VerticalAlignment="Center" Foreground="#6B7480" />
                                    <TextBlock Grid.Column="1" Margin="5,0" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="#11151A" />
                                    <TextBlock Grid.Column="2" Margin="5,0" Text="{Binding Display}" VerticalAlignment="Center" Foreground="#4D5968" />
                                    <TextBlock Grid.Column="3" Margin="5,0" Text="{Binding Image}" VerticalAlignment="Center" Foreground="#4D5968" />
                                </Grid>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#D7DDE5" />

            <Grid Grid.Column="2" Background="#EEF2F6">
                <ScrollViewer x:Name="SceneScrollViewer"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              PreviewMouseWheel="SceneScrollViewer_PreviewMouseWheel"
                              SizeChanged="SceneScrollViewer_SizeChanged">
                    <local:SceneRenderSurface x:Name="RenderSurface"
                                              CenterContentHorizontally="True"
                                              ShowGrid="False"
                                              ShowSelectionBounds="True"
                                              MouseLeftButtonDown="RenderSurface_MouseLeftButtonDown" />
                </ScrollViewer>
                <Border x:Name="EmptyOverlay"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="460"
                        Background="#DDE7EAEE"
                        BorderBrush="#657181"
                        BorderThickness="1"
                        Padding="22"
                        CornerRadius="6">
                    <StackPanel>
                        <TextBlock Text="打开一个 .sbscene 文件"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="#20242A" />
                        <TextBlock Text="可同时选择或拖入同目录的 .svo，图集解码后会按 CIMG crop 和节点 Transform2D 绘制。"
                                   Margin="0,8,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="#384150" />
                    </StackPanel>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch" Background="#D7DDE5" />

            <Grid Grid.Column="4" Background="#F7F9FC">
                <Grid.RowDefinitions>
                    <RowDefinition Height="210" MinHeight="140" />
                    <RowDefinition Height="5" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#D7DDE5" BorderThickness="0,0,0,1" Padding="12">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top"
                                   Text="选中节点"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="SelectedNodeInfoTextBlock"
                                       FontFamily="Consolas"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Foreground="#384150" />
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" Background="#D7DDE5" />

                <Grid Grid.Row="2" Background="#EEF2F6">
                    <DockPanel>
                        <Border DockPanel.Dock="Top"
                                Background="#FFFFFF"
                                BorderBrush="#D7DDE5"
                                BorderThickness="0,0,0,1"
                                Padding="12,9">
                            <DockPanel LastChildFill="True">
                                <CheckBox x:Name="SelectionPreviewBoundsCheckBox"
                                          DockPanel.Dock="Right"
                                          Content="显示节点框"
                                          IsChecked="True"
                                          Checked="SelectionPreviewBounds_Changed"
                                          Unchecked="SelectionPreviewBounds_Changed" />
                                <TextBlock Text="选中子树预览"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                        <ScrollViewer x:Name="SelectionScrollViewer"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto"
                                      SizeChanged="SelectionScrollViewer_SizeChanged">
                            <local:SceneRenderSurface x:Name="SelectionRenderSurface"
                                                      ShowGrid="False"
                                                      ShowAxes="False"
                                                      ShowSelectionBounds="True"
                                                      IsHitTestVisible="False" />
                        </ScrollViewer>
                    </DockPanel>
                    <Border x:Name="SelectionEmptyOverlay"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            MaxWidth="260"
                            Background="#DDE7EAEE"
                            BorderBrush="#657181"
                            BorderThickness="1"
                            Padding="14"
                            CornerRadius="6">
                        <TextBlock x:Name="SelectionEmptyTextBlock"
                                   Text="未选择节点。"
                                   TextWrapping="Wrap"
                                   Foreground="#384150" />
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#D7DDE5" BorderThickness="0,1,0,0" Padding="12,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="AnimationCountTextBlock"
                           Grid.Column="0"
                           Margin="0,0,12,0"
                           VerticalAlignment="Center"
                           Foreground="#5E6B7A"
                           Text="0 animations" />
                <ComboBox x:Name="AnimationComboBox"
                          Grid.Column="1"
                          Margin="0,0,12,0"
                          MinWidth="180"
                          VerticalAlignment="Center"
                          SelectionChanged="AnimationComboBox_SelectionChanged" />
                <TextBlock x:Name="AnimationFrameTextBlock"
                           Grid.Column="2"
                           Margin="0,0,12,0"
                           VerticalAlignment="Center"
                           Foreground="#4D5968"
                           Text="Frame 0 / 0" />
                <Slider x:Name="AnimationFrameSlider"
                        Grid.Column="3"
                        Minimum="0"
                        Maximum="0"
                        Margin="10,0"
                        TickFrequency="1"
                        VerticalAlignment="Center"
                        ValueChanged="AnimationFrameSlider_ValueChanged" />
                <Button x:Name="PlayAnimationButton"
                        Grid.Column="4"
                        Content="播放"
                        Click="PlayAnimation_Click" />
                <Button x:Name="PauseAnimationButton"
                        Grid.Column="5"
                        Content="暂停"
                        Click="PauseAnimation_Click" />
                <Button x:Name="StopAnimationButton"
                        Grid.Column="6"
                        Content="停止"
                        Click="StopAnimation_Click" />
                <CheckBox x:Name="LockAnimationSlotCheckBox"
                          Grid.Column="7"
                          Content="锁定slot"
                          Checked="LockAnimationSlot_Changed"
                          Unchecked="LockAnimationSlot_Changed" />
                <CheckBox x:Name="LoopAnimationCheckBox"
                          Grid.Column="8"
                          Margin="5,0,5,0"
                          Content="循环"
                          Checked="LoopAnimation_Changed"
                          Unchecked="LoopAnimation_Changed" />
                <Button x:Name="ResetAnimationStatesButton"
                        Grid.Column="9"
                        Content="重置所有状态"
                        Click="ResetAnimationStates_Click" />
            </Grid>
        </Border>

        <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="#D7DDE5" BorderThickness="0,1,0,0" Padding="10,7">
            <TextBlock x:Name="StatusTextBlock"
                       Foreground="#4D5968"
                       TextTrimming="CharacterEllipsis" />
        </Border>
    </Grid>
</Window>
