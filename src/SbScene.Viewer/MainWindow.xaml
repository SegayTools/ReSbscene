<Window x:Class="SbScene.Viewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SbScene.Viewer"
        mc:Ignorable="d"
        Title="SbScene Viewer"
        MinHeight="640"
        MinWidth="980"
        Height="820"
        Width="1280"
        Background="#F5F7FA"
        AllowDrop="True"
        Drop="Window_Drop">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="MinHeight" Value="30" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="10,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#1F2933" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#1F2933" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#D7DDE5" BorderThickness="0,0,0,1" Padding="12,10">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button Content="打开 sbscene" Click="OpenScene_Click" />
                    <Button Content="绑定 SVO" Click="OpenSvo_Click" />
                    <Button Content="重新载入" Click="Reload_Click" />
                    <Button Content="适合窗口" Click="Fit_Click" />
                    <CheckBox x:Name="ShowHiddenCheckBox"
                              Content="隐藏节点也绘制"
                              Checked="RenderOption_Changed"
                              Unchecked="RenderOption_Changed" />
                    <CheckBox x:Name="ShowMarkersCheckBox"
                              Content="节点标记"
                              IsChecked="True"
                              Checked="RenderOption_Changed"
                              Unchecked="RenderOption_Changed" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="缩放" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="#5E6B7A" />
                    <Slider x:Name="ZoomSlider"
                            Width="160"
                            Minimum="0.1"
                            Maximum="4"
                            TickFrequency="0.1"
                            Value="1"
                            ValueChanged="ZoomSlider_ValueChanged" />
                    <TextBlock x:Name="ZoomTextBlock"
                               Width="52"
                               TextAlignment="Right"
                               VerticalAlignment="Center"
                               Foreground="#5E6B7A" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" MinWidth="280" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" MinWidth="360" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="380" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#F7F9FC" BorderBrush="#D7DDE5" BorderThickness="0,0,1,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="12" Background="#FFFFFF" BorderBrush="#D7DDE5" BorderThickness="0,0,0,1">
                        <StackPanel>
                            <TextBlock x:Name="SceneTitleTextBlock" FontSize="15" FontWeight="SemiBold" Text="未加载 scene" />
                            <TextBlock x:Name="SceneSummaryTextBlock"
                                       Margin="0,6,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="#5E6B7A" />
                            <TextBlock x:Name="SvoSummaryTextBlock"
                                       Margin="0,4,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="#28775B" />
                        </StackPanel>
                    </Border>
                    <TreeView x:Name="NodeTree"
                              Background="#F7F9FC"
                              BorderThickness="0"
                              Foreground="#11151A"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              SelectedItemChanged="NodeTree_SelectedItemChanged">
                        <TreeView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="显示此节点和子节点" Click="ShowSubtree_Click" />
                                <MenuItem Header="隐藏此节点和子节点" Click="HideSubtree_Click" />
                                <Separator />
                                <MenuItem Header="恢复源文件显示状态" Click="ResetSubtreeVisibility_Click" />
                            </ContextMenu>
                        </TreeView.ContextMenu>
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="{x:Type TreeViewItem}">
                                <Setter Property="IsExpanded" Value="True" />
                                <EventSetter Event="PreviewMouseRightButtonDown" Handler="NodeTreeItem_PreviewMouseRightButtonDown" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <Grid MinWidth="260" Height="26" Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="54" />
                                        <ColumnDefinition Width="42" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Index}" Margin="4,0,0,0" VerticalAlignment="Center" Foreground="#6B7480" />
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="#11151A" />
                                    <TextBlock Grid.Column="2" Text="{Binding Display}" VerticalAlignment="Center" Foreground="#4D5968" />
                                    <TextBlock Grid.Column="3" Text="{Binding Image}" VerticalAlignment="Center" Foreground="#4D5968" />
                                </Grid>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#D7DDE5" />

            <Grid Grid.Column="2" Background="#EEF2F6">
                <ScrollViewer x:Name="SceneScrollViewer"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              PreviewMouseWheel="SceneScrollViewer_PreviewMouseWheel">
                    <local:SceneRenderSurface x:Name="RenderSurface"
                                              MouseLeftButtonDown="RenderSurface_MouseLeftButtonDown" />
                </ScrollViewer>
                <Border x:Name="EmptyOverlay"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="460"
                        Background="#DDE7EAEE"
                        BorderBrush="#657181"
                        BorderThickness="1"
                        Padding="22"
                        CornerRadius="6">
                    <StackPanel>
                        <TextBlock Text="打开一个 .sbscene 文件"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="#20242A" />
                        <TextBlock Text="可同时选择或拖入同目录的 .svo，图集解码后会按 CIMG crop 和节点 Transform2D 绘制。"
                                   Margin="0,8,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="#384150" />
                    </StackPanel>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch" Background="#D7DDE5" />

            <Grid Grid.Column="4" Background="#F7F9FC">
                <Grid.RowDefinitions>
                    <RowDefinition Height="210" MinHeight="140" />
                    <RowDefinition Height="5" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#D7DDE5" BorderThickness="0,0,0,1" Padding="12">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top"
                                   Text="选中节点"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="SelectedNodeInfoTextBlock"
                                       FontFamily="Consolas"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Foreground="#384150" />
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" Background="#D7DDE5" />

                <Grid Grid.Row="2" Background="#EEF2F6">
                    <DockPanel>
                        <Border DockPanel.Dock="Top"
                                Background="#FFFFFF"
                                BorderBrush="#D7DDE5"
                                BorderThickness="0,0,0,1"
                                Padding="12,9">
                            <TextBlock Text="选中子树预览"
                                       FontSize="15"
                                       FontWeight="SemiBold" />
                        </Border>
                        <ScrollViewer x:Name="SelectionScrollViewer"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto"
                                      SizeChanged="SelectionScrollViewer_SizeChanged">
                            <local:SceneRenderSurface x:Name="SelectionRenderSurface"
                                                      IsHitTestVisible="False" />
                        </ScrollViewer>
                    </DockPanel>
                    <Border x:Name="SelectionEmptyOverlay"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            MaxWidth="260"
                            Background="#DDE7EAEE"
                            BorderBrush="#657181"
                            BorderThickness="1"
                            Padding="14"
                            CornerRadius="6">
                        <TextBlock x:Name="SelectionEmptyTextBlock"
                                   Text="未选择节点。"
                                   TextWrapping="Wrap"
                                   Foreground="#384150" />
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#D7DDE5" BorderThickness="0,1,0,0" Padding="10,7">
            <TextBlock x:Name="StatusTextBlock"
                       Foreground="#4D5968"
                       TextTrimming="CharacterEllipsis" />
        </Border>
    </Grid>
</Window>
