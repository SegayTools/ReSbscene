<Window x:Class="SbScene.Viewer.GifExportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="导出 GIF"
        Height="560"
        Width="660"
        MinHeight="520"
        MinWidth="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#F5F7FA">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#1F2933" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="MinWidth" Value="84" />
            <Setter Property="MinHeight" Value="30" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,0,18,8" />
            <Setter Property="Foreground" Value="#1F2933" />
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="导出当前场景的动画 GIF。当前选中的动画会作为时间轴播放，已锁定的 slot 会作为固定叠加层。"
                   Foreground="#4D5968"
                   TextWrapping="Wrap" />

        <ScrollViewer Grid.Row="1" Margin="0,16,0,16" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="输出 GIF" VerticalAlignment="Center" />
                    <TextBox x:Name="OutputPathTextBox" Grid.Column="1" />
                    <Button Grid.Column="3" Content="浏览..." Click="BrowseOutput_Click" />
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="FPS" VerticalAlignment="Center" />
                    <TextBox x:Name="FpsTextBox" Grid.Column="1" PreviewTextInput="IntegerTextBox_PreviewTextInput" />
                    <TextBlock Grid.Column="3" Text="Matte 颜色" VerticalAlignment="Center" />
                    <TextBox x:Name="MatteColorTextBox" Grid.Column="4" />
                    <TextBlock Grid.Column="5"
                               Margin="10,0,0,0"
                               Text="#RRGGBB"
                               Foreground="#5E6B7A"
                               VerticalAlignment="Center" />
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Padding" VerticalAlignment="Center" />
                    <TextBox x:Name="PaddingTextBox" Grid.Column="1" PreviewTextInput="IntegerTextBox_PreviewTextInput" />
                    <TextBlock Grid.Column="3" Text="Scale" VerticalAlignment="Center" />
                    <TextBox x:Name="ScaleTextBox" Grid.Column="4" />
                </Grid>

                <CheckBox x:Name="UseFrameRangeCheckBox"
                          Content="指定源帧范围"
                          Checked="UseFrameRange_Changed"
                          Unchecked="UseFrameRange_Changed" />
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Start frame" VerticalAlignment="Center" />
                    <TextBox x:Name="StartFrameTextBox" Grid.Column="1" />
                    <TextBlock Grid.Column="3" Text="End frame" VerticalAlignment="Center" />
                    <TextBox x:Name="EndFrameTextBox" Grid.Column="4" />
                </Grid>

                <TextBlock Text="等比缩放"
                           FontWeight="SemiBold"
                           Margin="0,2,0,10" />
                <WrapPanel Margin="0,0,0,4">
                    <CheckBox x:Name="UseTargetWidthCheckBox"
                              Content="指定宽度"
                              Checked="TargetSize_Changed"
                              Unchecked="TargetSize_Changed" />
                    <TextBox x:Name="TargetWidthTextBox"
                             Width="90"
                             Margin="0,0,24,8"
                             PreviewTextInput="IntegerTextBox_PreviewTextInput" />
                    <CheckBox x:Name="UseTargetHeightCheckBox"
                              Content="指定高度"
                              Checked="TargetSize_Changed"
                              Unchecked="TargetSize_Changed" />
                    <TextBox x:Name="TargetHeightTextBox"
                             Width="90"
                             Margin="0,0,0,8"
                             PreviewTextInput="IntegerTextBox_PreviewTextInput" />
                </WrapPanel>

                <TextBlock Text="选项"
                           FontWeight="SemiBold"
                           Margin="0,8,0,10" />
                <WrapPanel>
                    <CheckBox x:Name="CompressFramesCheckBox" Content="压缩变化帧" />
                    <CheckBox x:Name="HighQualityCheckBox" Content="高质量采样" />
                    <CheckBox x:Name="ShowHiddenCheckBox" Content="隐藏节点也渲染" />
                    <CheckBox x:Name="CharacterDefaultsCheckBox" Content="叠加角色默认动画" />
                </WrapPanel>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                BorderBrush="#D7DDE5"
                BorderThickness="0,1,0,0"
                Padding="0,14,0,0">
            <DockPanel LastChildFill="False">
                <TextBlock x:Name="ErrorTextBlock"
                           DockPanel.Dock="Left"
                           Foreground="#B42318"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="取消"
                            Margin="0,0,8,0"
                            IsCancel="True" />
                    <Button Content="导出"
                            IsDefault="True"
                            Click="Ok_Click" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
