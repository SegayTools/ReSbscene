<Window x:Class="SbScene.Viewer.NavigationCharacterPatchDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="修补 NavigationCharacter prefab AB"
        Height="430"
        Width="660"
        MinHeight="400"
        MinWidth="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#F5F7FA">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#1F2933" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="MinWidth" Value="84" />
            <Setter Property="MinHeight" Value="30" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,0,18,8" />
            <Setter Property="Foreground" Value="#1F2933" />
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="改写 prefab AssetBundle 内 NavigationCharacter MonoBehaviour 的 m_Script.m_PathID。"
                   Foreground="#4D5968"
                   TextWrapping="Wrap" />

        <StackPanel Grid.Row="1" Margin="0,16,0,16">
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="输入 AB" VerticalAlignment="Center" />
                <TextBox x:Name="InputPathTextBox" Grid.Column="1" />
                <Button Grid.Column="3" Content="浏览..." Click="BrowseInput_Click" />
            </Grid>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="输出 AB" VerticalAlignment="Center" />
                <TextBox x:Name="OutputPathTextBox" Grid.Column="1" />
                <Button Grid.Column="3" Content="浏览..." Click="BrowseOutput_Click" />
            </Grid>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="目标 PathID" VerticalAlignment="Center" />
                <TextBox x:Name="PathIdTextBox" Grid.Column="1" />
                <TextBlock Grid.Column="2"
                           Margin="12,0,0,0"
                           Text="写入 m_Script.m_PathID"
                           Foreground="#5E6B7A"
                           VerticalAlignment="Center" />
            </Grid>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="脚本类名" VerticalAlignment="Center" />
                <TextBox x:Name="ScriptNameTextBox" Grid.Column="1" />
                <TextBlock Grid.Column="2"
                           Margin="12,0,0,0"
                           Text="用于定位 MonoScript"
                           Foreground="#5E6B7A"
                           VerticalAlignment="Center" />
            </Grid>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="压缩方式" VerticalAlignment="Center" />
                <ComboBox x:Name="CompressionComboBox"
                          Grid.Column="1"
                          MinHeight="30"
                          DisplayMemberPath="Label"
                          SelectedValuePath="Value" />
                <TextBlock Grid.Column="2"
                           Margin="12,0,0,0"
                           Text="keep / none / lz4 / lzma"
                           Foreground="#5E6B7A"
                           VerticalAlignment="Center" />
            </Grid>

            <CheckBox x:Name="DryRunCheckBox" Content="Dry-run：只报告将修改的 MonoBehaviour 数量，不写出文件" />
        </StackPanel>

        <Border Grid.Row="2"
                BorderBrush="#D7DDE5"
                BorderThickness="0,1,0,0"
                Padding="0,14,0,0">
            <DockPanel LastChildFill="False">
                <TextBlock x:Name="ErrorTextBlock"
                           DockPanel.Dock="Left"
                           Foreground="#B42318"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="取消"
                            Margin="0,0,8,0"
                            IsCancel="True" />
                    <Button Content="执行"
                            IsDefault="True"
                            Click="Ok_Click" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
